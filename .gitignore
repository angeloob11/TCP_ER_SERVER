# Entorno virtual de Python
venv/
.venv/

# Python compilado
__pycache__/
*.py[cod]

# Maquina virtual URSim y comprimidos (cientos de MB)
URSim_VIRTUAL-*/
*.rar
*.zip
*.vmdk
*.vbox
*.vbox-prev
*.vmx
*.log

# Wheel del visualizador (se distribuye por el aula virtual)
*.whl

# Documentacion de terceros (copyright de Universal Robots)
referencias/

# Ficheros de sistema y editores
.vscode/
.idea/
Thumbs.db
desktop.ini

# Salida de PyInstaller (se regenera con: pyinstaller multi_robot.spec)
build/
dist/
# PKI: solo se suben los certificados públicos
PKI/ca-privado/
PKI/**/*.key
PKI/**/*.csr
PKI/**/*.p12
PKI/**/*.srl
PKI/**/antiguo_*/
PKI/informe_E1.txt

# Claves privadas: nunca a git, estén en la carpeta que estén
# (p. ej. una PKI copiada dentro de ejecutables/)
*.key
*.p12
*.csr
